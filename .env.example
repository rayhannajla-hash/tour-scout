# Copy to .env (never commit it) or set these as secrets on the host.
QLOO_API_KEY=
# Agent brain: set ONE of these (Gemini wins if both are set; LLM_PROVIDER overrides)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
PORT=8787
RUNS_PER_HOUR=6
MAX_CONCURRENT=2
